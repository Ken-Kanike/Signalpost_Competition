# Signalpost Environment Configuration Example
# Copy to .env and configure as needed

# Synthesis Engine: 'template' (default, $0 cost, zero hallucination) or 'llm'
SYNTHESIS_MODE=template

# Optional: OpenAI API Key if using SYNTHESIS_MODE=llm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Network & Concurrency
MAX_DAILY_REQUESTS=2000
DEFAULT_PER_COMPANY_CAP=14
PER_HOST_MIN_INTERVAL_SEC=0.5
MAX_CONCURRENT_WORKERS=15
